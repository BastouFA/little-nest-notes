# Little Nest Notes: optional build settings.
# The main place for these values is the "site" block in links.json. Anything set
# here as an environment variable (in the Netlify / Vercel dashboard, as a GitHub
# Actions repository variable, or exported in your shell) overrides links.json.
# The build does not read a .env file by itself: export the variables, e.g.
#   PLAUSIBLE_DOMAIN=littlenestnotes.com python3 scripts/apply_links.py
# This site has no secret keys. Affiliate links are public by design.

# Live address of the site, no trailing slash (used in canonical/OG URLs, sitemap, robots.txt)
SITE_URL=https://littlenestnotes.example.com

# Cookieless analytics. The domain exactly as added in your Plausible account.
# Leave empty to load no analytics script at all.
PLAUSIBLE_DOMAIN=

# GitHub Pages only (already set in .github/workflows/pages.yml): embed the
# security policy as <meta> tags because Pages cannot send HTTP headers.
# EMBED_SECURITY_META=1
